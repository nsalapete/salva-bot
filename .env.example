# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=salva
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salva
# Letters and digits only (used inside a URL)
INVENTORY_API_DB_PASSWORD=change-me
# n8n encryption key: must never change once set, or stored credentials become unreadable
N8N_ENCRYPTION_KEY=change-me
